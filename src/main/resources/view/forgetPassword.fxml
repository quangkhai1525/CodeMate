<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="1000.0"
           style="-fx-background-color: linear-gradient(to bottom right, #0b132b, #1c2541, #0f172a);"
           xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.ForgotPasswordController">

    <VBox alignment="CENTER" maxWidth="440.0" spacing="20.0"
          style="-fx-background-color: rgba(19, 31, 55, 0.9); -fx-background-radius: 24px; -fx-border-color: rgba(56, 189, 248, 0.35); -fx-border-radius: 24px; -fx-border-width: 1.5px; -fx-padding: 36 34 36 34; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.45), 24, 0, 0, 8);">

        <!-- HEADER -->
        <VBox alignment="CENTER" spacing="6.0">
            <Label text="🔑 QUÊN MẬT KHẨU"
                   style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #38bdf8; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.5), 10, 0.3, 0, 0);"/>
            <Label text="Nhập email đã đăng ký để nhận mã xác nhận OTP"
                   style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
        </VBox>

        <!-- EMAIL SECTION -->
        <VBox spacing="6.0">
            <Label text="Email đã đăng ký" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
            <HBox spacing="8.0">
                <TextField fx:id="emailFG" promptText="email@example.com" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: #0b132b; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 11 14; -fx-font-size: 13px;"/>
                <Button fx:id="sendOTPFG" text="Gửi OTP" onAction="#sendOTPFG"
                        style="-fx-background-color: #38bdf8; -fx-text-fill: #0f172a; -fx-font-weight: 800; -fx-padding: 11 16; -fx-background-radius: 12px; -fx-cursor: hand;"/>
            </HBox>
            <Label fx:id="errorEmail" textFill="#f87171" style="-fx-font-size: 12px;"/>
        </VBox>

        <!-- OTP SECTION -->
        <VBox spacing="6.0">
            <Label text="Mã xác nhận (OTP)" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
            <TextField fx:id="OTPFG" promptText="Nhập mã 6 chữ số gửi về email"
                       style="-fx-background-color: #0b132b; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 11 14; -fx-font-size: 14px;"/>
            <Label fx:id="errorOTP" textFill="#f87171" style="-fx-font-size: 12px;"/>
        </VBox>

        <!-- SUBMIT BUTTON -->
        <Button fx:id="checkOTPFG" text="Tiếp tục xác nhận" onAction="#checkOTPFG" maxWidth="Infinity"
                style="-fx-background-color: linear-gradient(to right, #0284c7, #38bdf8); -fx-text-fill: #0f172a; -fx-font-size: 14px; -fx-font-weight: 900; -fx-padding: 12 0; -fx-background-radius: 14px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.4), 10, 0.2, 0, 2);"/>

        <!-- BACK TO LOGIN -->
        <HBox alignment="CENTER" spacing="6.0">
            <Button fx:id="comeBackFG1" text="← Quay lại Đăng nhập" onMouseClicked="#comeBackFG1"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</StackPane>
