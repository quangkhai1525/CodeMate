<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="1000.0"
           style="-fx-background-color: linear-gradient(to bottom right, #0b132b, #1c2541, #0f172a);"
           xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.LoginController">

    <!-- FORM CARD GLASSMORPHISM Ở CHÍNH GIỮA MÀN HÌNH -->
    <VBox alignment="CENTER" maxWidth="440.0" spacing="20.0"
          style="-fx-background-color: rgba(19, 31, 55, 0.85); -fx-background-radius: 24px; -fx-border-color: rgba(56, 189, 248, 0.35); -fx-border-radius: 24px; -fx-border-width: 1.5px; -fx-padding: 38 34 38 34; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.45), 24, 0, 0, 8);">

        <!-- HEADER -->
        <VBox alignment="CENTER" spacing="6.0">
            <Label text="⚡ CODEMATE"
                   style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #38bdf8; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.5), 10, 0.3, 0, 0);"/>
            <Label text="Đăng nhập để bắt đầu phiên làm việc &amp; nạp nước"
                   style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
        </VBox>

        <!-- INPUT FIELDS -->
        <VBox spacing="14.0" style="-fx-padding: 10 0 0 0;">
            <!-- USERNAME -->
            <VBox spacing="6.0">
                <Label text="Tên đăng nhập" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
                <TextField fx:id="usernameLG" promptText="Nhập tên đăng nhập của bạn"
                           style="-fx-background-color: #0b132b; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 11 14; -fx-font-size: 14px;"/>
                <Label fx:id="errorUsername" textFill="#f87171" style="-fx-font-size: 12px;"/>
            </VBox>

            <!-- PASSWORD -->
            <VBox spacing="6.0">
                <Label text="Mật khẩu" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
                <StackPane alignment="CENTER_RIGHT">
                    <PasswordField fx:id="passwordLG" promptText="••••••••"
                                   style="-fx-background-color: #0b132b; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 11 44 11 14; -fx-font-size: 14px;"/>
                    <TextField fx:id="passwordTextLG" visible="false" promptText="Nhập mật khẩu"
                               style="-fx-background-color: #0b132b; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 11 44 11 14; -fx-font-size: 14px;"/>
                    <Button fx:id="showPassword" onAction="#showPassword"
                            style="-fx-background-color: transparent; -fx-padding: 0 12 0 0; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fx:id="iconEYE" fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../assets/images/icon/closeEye.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </StackPane>
                <Label fx:id="errorPassword" textFill="#f87171" style="-fx-font-size: 12px;"/>
            </VBox>

            <!-- REMEMBER & FORGOT PASSWORD -->
            <HBox alignment="CENTER_LEFT">
                <CheckBox fx:id="rememberLG" text="Ghi nhớ đăng nhập"
                          style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-cursor: hand;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="forgetLG" text="Quên mật khẩu?" onAction="#forgetLG"
                        style="-fx-background-color: transparent; -fx-text-fill: #38bdf8; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;"/>
            </HBox>
        </VBox>

        <!-- BUTTON LOGIN -->
        <Button fx:id="loginLG" text="Đăng nhập" onAction="#loginLG" maxWidth="Infinity"
                style="-fx-background-color: linear-gradient(to right, #0284c7, #38bdf8); -fx-text-fill: #0f172a; -fx-font-size: 15px; -fx-font-weight: 900; -fx-padding: 12 0; -fx-background-radius: 14px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.4), 10, 0.2, 0, 2);"/>

        <!-- REGISTER LINK -->
        <HBox alignment="CENTER" spacing="6.0" style="-fx-padding: 6 0 0 0;">
            <Label text="Chưa có tài khoản?" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
            <Button fx:id="registerLG" text="Đăng ký ngay" onAction="#registerLG"
                    style="-fx-background-color: transparent; -fx-text-fill: #38bdf8; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;"/>
        </HBox>
    </VBox>
</StackPane>
