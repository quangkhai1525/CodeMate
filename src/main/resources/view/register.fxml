<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="750.0" prefWidth="1000.0"
           style="-fx-background-color: linear-gradient(to bottom right, #0b132b, #1c2541, #0f172a);"
           xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.RegisterController">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <content>
            <VBox alignment="CENTER" style="-fx-padding: 30 0 30 0;">
                <VBox alignment="CENTER" maxWidth="480.0" spacing="16.0"
                      style="-fx-background-color: rgba(19, 31, 55, 0.9); -fx-background-radius: 24px; -fx-border-color: rgba(56, 189, 248, 0.35); -fx-border-radius: 24px; -fx-border-width: 1.5px; -fx-padding: 34 36 34 36; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.45), 24, 0, 0, 8);">

                    <!-- HEADER -->
                    <VBox alignment="CENTER" spacing="6.0">
                        <Label text="⚡ ĐĂNG KÝ TÀI KHOẢN"
                               style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #38bdf8; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.5), 10, 0.3, 0, 0);"/>
                        <Label text="Tạo tài khoản CodeMate để theo dõi năng suất mỗi ngày"
                               style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
                    </VBox>

                    <!-- INPUT FIELDS -->
                    <VBox spacing="10.0" style="-fx-padding: 6 0 0 0;">
                        <!-- FULLNAME -->
                        <VBox spacing="4.0">
                            <Label text="Họ và tên" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
                            <TextField fx:id="fullnameRGS" promptText="Ví dụ: Nguyễn Văn A"
                                       style="-fx-background-color: #0b132b; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 9 12; -fx-font-size: 13px;"/>
                            <Label fx:id="errorFullname" textFill="#f87171" style="-fx-font-size: 11px;"/>
                        </VBox>

                        <!-- USERNAME -->
                        <VBox spacing="4.0">
                            <Label text="Tên đăng nhập" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
                            <TextField fx:id="usernameRGS" promptText="Nhập username"
                                       style="-fx-background-color: #0b132b; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 9 12; -fx-font-size: 13px;"/>
                            <Label fx:id="errorUsername" textFill="#f87171" style="-fx-font-size: 11px;"/>
                        </VBox>

                        <!-- EMAIL -->
                        <VBox spacing="4.0">
                            <Label text="Email" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
                            <TextField fx:id="emailRGS" promptText="email@example.com"
                                       style="-fx-background-color: #0b132b; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 9 12; -fx-font-size: 13px;"/>
                            <Label fx:id="errorEmail" textFill="#f87171" style="-fx-font-size: 11px;"/>
                        </VBox>

                        <!-- PASSWORD -->
                        <VBox spacing="4.0">
                            <Label text="Mật khẩu" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
                            <PasswordField fx:id="passwordRGS" promptText="••••••••"
                                           style="-fx-background-color: #0b132b; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 9 12; -fx-font-size: 13px;"/>
                            <Label fx:id="errorPassword" textFill="#f87171" style="-fx-font-size: 11px;"/>
                        </VBox>

                        <!-- CONFIRM PASSWORD -->
                        <VBox spacing="4.0">
                            <Label text="Xác nhận mật khẩu" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
                            <PasswordField fx:id="checkPasswordRGS" promptText="••••••••"
                                           style="-fx-background-color: #0b132b; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 9 12; -fx-font-size: 13px;"/>
                            <Label fx:id="errorCheckPassword" textFill="#f87171" style="-fx-font-size: 11px;"/>
                        </VBox>
                    </VBox>

                    <!-- BUTTON REGISTER -->
                    <Button fx:id="registerRGS" text="Đăng ký tài khoản" onAction="#registerRGS" maxWidth="Infinity"
                            style="-fx-background-color: linear-gradient(to right, #0284c7, #38bdf8); -fx-text-fill: #0f172a; -fx-font-size: 14px; -fx-font-weight: 900; -fx-padding: 12 0; -fx-background-radius: 12px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.4), 10, 0.2, 0, 2);"/>

                    <!-- LOGIN LINK -->
                    <HBox alignment="CENTER" spacing="6.0" style="-fx-padding: 4 0 0 0;">
                        <Label text="Đã có tài khoản?" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                        <Button fx:id="loginRGS" text="Đăng nhập ngay" onAction="#loginRGS"
                                style="-fx-background-color: transparent; -fx-text-fill: #38bdf8; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;"/>
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</StackPane>
